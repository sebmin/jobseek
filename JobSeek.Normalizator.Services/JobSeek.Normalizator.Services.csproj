<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>JobSeek.Normalizator.Services</RootNamespace>
    <AssemblyName>JobSeek.Normalizator.Services</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FuzzySharp" Version="2.0.2" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.2" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JobSeek.Normalizator.Contracts\JobSeek.Normalizator.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JobSeek.Normalizator.Services.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data\skill-aliases.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Models\paraphrase-multilingual-MiniLM-L12-v2\model.onnx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Models\paraphrase-multilingual-MiniLM-L12-v2\sentencepiece.bpe.model" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
