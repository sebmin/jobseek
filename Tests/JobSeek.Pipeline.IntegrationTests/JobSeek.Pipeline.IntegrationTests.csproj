    <ProjectReference Include="..\..\JobSeek.Prompter.Contracts\JobSeek.Prompter.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
